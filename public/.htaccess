# Apache rewrite rules for Next.js static export (trailingSlash: true).
# NOTE: The analytics API is a separate cPanel subdomain (api-new.mrivas.dev),
# reached cross-origin (CORS is configured on the backend). Do NOT proxy /api
# from here — there is no local backend to proxy to on this host.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback: directory index.html (trailing-slash routes).
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>
